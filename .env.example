# MinIO (Phase 1 + 2)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Phase 3: Oracle 23ai Free
# Admin password (used by the container at boot, and by 'idx-oracle-shell' as SYS)
ORACLE_PWD=RagPass_2026
# Application user password (created by 'make idx-bootstrap-user', see Step E)
ORACLE_APP_PWD=RagApp_2026

# Phase 3: Ollama (running in Docker on the ragnet network)
# - From the HOST (CLI, IDE): http://localhost:11434
# - From INSIDE rag-spark container: http://ollama:11434
OLLAMA_BASE_URL_HOST=http://localhost:11434
OLLAMA_BASE_URL_NETWORK=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
