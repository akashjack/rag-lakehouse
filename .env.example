# MinIO (Phase 1 + 2)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Phase 3: Oracle 23ai Free
ORACLE_PWD=RagPass_2026

# Phase 3: Remote Ollama (running outside Docker)
# Must be reachable from the embed-job runtime — i.e. either:
#  - from your host (if running CLI commands directly), and
#  - from inside the Spark container (uses 'host.docker.internal' on Mac/Windows;
#    on Linux Docker Desktop, also resolves; on plain Linux Docker, set the LAN IP).
OLLAMA_BASE_URL=http://192.168.193.45:11434

# Embedding model
OLLAMA_EMBED_MODEL=nomic-embed-text
